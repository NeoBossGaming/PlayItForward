[node name="World" type="Node2D" parent="."]

; --- the river ---------------------------------------------------------------
; The player is floating WITH the current, so in camera terms the surface does
; not translate at all and the banks are what fly past. Life comes from the
; layers over it, never from dragging the base along -- that reads as a
; conveyor belt rather than a river.
;
; The base is deliberately at zero rather than merely slow. Textures snap a
; whole pixel at a time under nearest filtering, and one game pixel is three
; on screen at 1080p, so a surface creeping at 4px/s ticks visibly once a
; quarter second. Anything that moves slowly here has to either not move or
; twinkle while it does.

[node name="Water" type="Sprite2D" parent="World"]
position = Vector2(240, 135)
texture = ExtResource("5")
script = ExtResource("4")
area = Vector2i(504, 318)

