[node name="World" type="Node2D" parent="."]

; --- the meadow --------------------------------------------------------------
; This ground DOES move, which is the one thing that separates this game from
; Acorn Storm's fixed clearing. Both layers' scroll is driven per frame from
; the curve, so the numbers here are only the starting state.
[node name="Ground" type="Sprite2D" parent="World"]
position = Vector2(240, 135)
texture = ExtResource("6")
script = ExtResource("4")
area = Vector2i(504, 318)

; The anti-tiling layer: 240px against the ground's 176, travelling at 0.62x
; its rate. Different size AND different speed, so the two periods never line
; up over any distance a player will watch. A bigger ground tile on its own
; would only have made the grid bigger.
[node name="Shade" type="Sprite2D" parent="World"]
position = Vector2(240, 135)
z_index = 1
texture = ExtResource("7")
script = ExtResource("4")
area = Vector2i(504, 318)

[node name="Props" type="Node2D" parent="."]

; No z_index on these three. Patches set their own blade and cover layers, and
; a value here would be ADDED to both -- which is how this project once drew a
; hazard over an airborne player and inverted its own rule.
[node name="Patches" type="Node2D" parent="."]

[node name="Pickups" type="Node2D" parent="."]

