[gd_resource type="Theme" load_steps=3 format=3]

[ext_resource type="FontFile" path="res://assets/game/fonts/PressStart2P-Regular.ttf" id="arcade"]
[ext_resource type="FontFile" path="res://assets/game/fonts/PixelifySans-Regular.ttf" id="body"]

; Size choices are not free. Press Start 2P is clean at any size but very wide.
; Pixelify Sans falls apart below 11px -- glyphs collapse into mush -- so 11 is
; a hard floor for body text, verified by rendering a size ladder.
[resource]
default_font = ExtResource("body")
default_font_size = 12
Label/colors/font_color = Color(0.96, 0.95, 1, 1)
Label/colors/font_outline_color = Color(0.06, 0.05, 0.1, 1)
Label/constants/outline_size = 3
Label/font_sizes/font_size = 12
Label/fonts/font = ExtResource("body")

